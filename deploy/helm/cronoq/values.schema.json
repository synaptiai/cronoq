{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicas": { "type": "integer", "minimum": 1 },
    "auth": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "insecureNoAuth": { "type": "boolean" }
      }
    },
    "store": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["memory", "postgres"] },
        "postgres": {
          "type": "object",
          "properties": {
            "urlSecret": {
              "type": "object",
              "properties": { "name": { "type": "string" }, "key": { "type": "string", "minLength": 1 } }
            },
            "schema": { "type": "string", "pattern": "^[a-z_][a-z0-9_{}]*$" },
            "keepFinishedSeconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "number", "pools"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Shard name: the server allows [a-z][a-z0-9_]{0,31} and Kubernetes names allow no '_', so lower-case letters and digits only.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9]{0,31}$"
          },
          "number": { "type": "integer", "minimum": 0, "maximum": 255 },
          "pools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "secretName": { "type": "string" },
        "requireClientCerts": { "type": "boolean" }
      }
    },
    "insecurePeerHttp": { "type": "boolean" },
    "grpcWeb": {
      "type": "object",
      "properties": {
        "allowedOrigins": { "type": "array", "items": { "type": "string", "pattern": "^https?://[^\\s\"]+$" } }
      }
    },
    "config": { "type": "string" },
    "service": {
      "type": "object",
      "properties": {
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "shutdownGraceSeconds": { "type": "integer", "minimum": 0 }
  }
}
