# cronoq-operator image: scales worker Deployments from a cronoq server's desired capacity.
#
# Base images are pinned by digest, like the server's (see Dockerfile). The runtime image is
# distroless and runs as a non-root user.

FROM rust:1.98-slim-bookworm@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730 AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p cronoq-operator --locked

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
COPY --from=build /src/target/release/cronoq-operator /usr/local/bin/cronoq-operator
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/cronoq-operator"]
